# 서버에서 `cp .env.example .env` 한 뒤 값을 채운다. .env는 깃에 올라가지 않고, docker compose가 자동으로 읽는다.
# 공개하는 서비스의 접근 키 (X-API-Key 헤더 · 로그인 화면). 비우면 누구나 쓸 수 있으니 서버에서는 꼭 채운다. 만들기: openssl rand -hex 16
API_KEY=
# 도메인이면 Caddy가 HTTPS 인증서를 자동으로 받는다 (예: mybank.duckdns.org). 비우면 :80 (HTTP, 접근 키가 평문으로 오간다).
# 가입 없이 쓰려면 IP를 이름에 넣은 sslip.io 주소 (예: 서버 IP가 1.2.3.4이면 1-2-3-4.sslip.io). 80 · 443이 열려 있어야 인증서를 받는다.
SITE_ADDRESS=
# 모델 제공사. 비우면 로컬 Ollama(기본). openai로 바꾸면 모델에 들어가는 질문 · 도구 결과 · 대화가 OpenAI 서버로 나간다 (전화번호 · 이메일 같은 모양은 보내기 전에 가린다).
# API를 쓰려면 LLM_PROVIDER=openai, LLM_ALLOW_EXTERNAL=1, OPENAI_API_KEY 셋이 모두 필요하다 (pip install -r requirements-api.txt). 키는 채팅 · 깃에 올리지 않는다.
LLM_PROVIDER=
LLM_ALLOW_EXTERNAL=
LLM_MODEL=
OPENAI_API_KEY=
# 모델이 temperature를 받지 않으면(400 오류) omit. 비우면 0. 중계 서버를 쓸 때만 OPENAI_BASE_URL.
LLM_TEMPERATURE=
OPENAI_BASE_URL=
# 하루 모델 호출 상한 (질문 1개 = 약 2회). 비우면 300, 0이면 상한 없음. 넘으면 모델을 부르지 않고 "오늘 사용 한도에 도달했어요"로 답한다 (한국 시간 기준, 서버를 다시 띄워도 유지).
LLM_DAILY_CALL_LIMIT=
