# SITE_ADDRESS: 도메인(예: mybank.duckdns.org)이면 HTTPS 인증서를 자동으로 받는다. 비우면 :80 (HTTP, 접근 키가 평문으로 오간다: 시험용).
{
	order rate_limit before basicauth
}

{$SITE_ADDRESS::80} {
	# 접근 로그: 누가 어떤 경로를 불렀는지 보려고 켠다. 접근 키(X-API-Key) · 쿠키 · 주소창 키는 남기지 않는다 (Caddy가 기본으로 가리는 것은 Cookie · Authorization뿐).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Api-Key delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Set-Cookie delete
				resp_headers>Set-Cookie delete
				request>uri query {
					delete api_key
					delete key
					delete token
				}
			}
		}
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	request_body {
		max_size 64KB
	}
	# 한 IP가 1분에 20번까지. /chat 한 번이 CPU에서 수십 초라 이 이상은 서버가 감당하지 못한다.
	rate_limit {
		zone per_ip {
			key {remote_host}
			events 20
			window 1m
		}
	}
	reverse_proxy api:8000 {
		transport http {
			response_header_timeout 600s
		}
	}
}
